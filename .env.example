# ============================================================
# .env.example - 环境变量配置示例
# 使用说明：复制此文件为 .env 后填入真实密钥
# 注意：.env 已在 .gitignore 中，永不提交密钥
# ============================================================

# ---------------------------
# 默认使用的图像模型
# 可选值: tongyi_wanxiang | dalle3 | ollama_sdxl | ollama_flux
# ---------------------------
DEFAULT_IMAGE_MODEL=ollama_sdxl

# ============================================================
# 方案A：云端商用API
# ============================================================

# ---------------------------
# 1. 通义万相（阿里DashScope平台）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# 推荐电商场景，画风写实、支持中文Prompt
# ---------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
TONGYI_MODEL_NAME=wanx-v1
TONGYI_BASE_URL=https://dashscope.aliyuncs.com

# ---------------------------
# 2. DALL·E3（OpenAI）
# 获取地址：https://platform.openai.com/api-keys
# 通用能力强，英文Prompt效果佳
# ---------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DALLE3_MODEL_NAME=dall-e-3
# DALL·E3画质：standard | hd（hd更清晰但2x成本）
DALLE3_QUALITY=hd

# ============================================================
# 方案B：本地离线免费（Ollama部署）
# ============================================================

# Ollama服务地址（本地部署默认）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SDXL模型：下载命令  ollama pull stable-diffusion
# 显存要求：4GB+
OLLAMA_SDXL_MODEL=stable-diffusion

# Flux模型：下载命令  ollama pull flux
# 显存要求：8GB+（推荐16GB），本地画质SOTA
OLLAMA_FLUX_MODEL=flux

# 本地推理超时时间（秒），Flux首次生成较慢可适当调大
OLLAMA_TIMEOUT=300
